---
import Base from './Base.astro';
import { articleSchema, faqSchema, type QA } from '../lib';
import Faq from '../components/Faq.astro';
import Author from '../components/Author.astro';
import { POSTS } from '../posts';
interface Props { path: string; faq?: QA[] }
const { path, faq = [] } = Astro.props;
const post = POSTS.find((p) => p.path === path)!;
const updated = (post as { updated?: string }).updated || post.date;
const schema: object[] = [articleSchema(post.title, path, post.desc, post.date, updated)];
if (faq.length) schema.push(faqSchema(faq));
---
<Base title={post.title} description={post.desc} ogType="article" crumbs={[{ name: 'Blog', path: '/blog/' }, { name: post.title, path }]} schema={schema}>
  <article class="wrap prose">
    <h1><span class="grad-text">{post.title}</span></h1>
    <Author date={post.date} updated={updated} />
    <slot />
    {faq.length > 0 && <Faq items={faq} />}
    <h2>More from the blog</h2>
    <ul>{POSTS.filter((p) => p.path !== path).map((p) => <li><a href={p.path}>{p.title}</a></li>)}</ul>
  </article>
</Base>
